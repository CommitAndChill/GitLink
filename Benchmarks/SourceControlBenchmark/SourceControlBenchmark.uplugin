	"IsBetaVersion": false,
	"EnabledByDefault": false,
	"Installed": false,
	"Modules": [
		{
			"Name": "SourceControlBenchmark",
			"Type": "UncookedOnly",
			"LoadingPhase": "Default"
		}
	]
}
